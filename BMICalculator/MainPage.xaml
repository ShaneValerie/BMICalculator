<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BMICalculator.MainPage"
             BackgroundColor="#F4F6FB">

    <ScrollView>
        <VerticalStackLayout Padding="20,50,20,30" Spacing="18">

            <!-- TITLE -->
            <Label Text="BMI CALCULATOR"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#3B4CCA"
                   CharacterSpacing="2"/>

            <!-- INPUT PAGE -->
            <VerticalStackLayout x:Name="InputPage" Spacing="18">

                <!-- AGE + WEIGHT -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">

                    <!-- AGE -->
                    <Border BackgroundColor="White"
                            StrokeShape="RoundRectangle 20"
                            Padding="20">

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Age"
                                   HorizontalOptions="Center"
                                   TextColor="#6B7280"/>

                            <Entry Keyboard="Numeric"
                                   Placeholder="Enter age"
                                   TextChanged="OnAgeTextChanged"
                                   HorizontalTextAlignment="Center"
                                   FontSize="30"
                                   TextColor="#3B4CCA"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- WEIGHT -->
                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 20"
                            Padding="20">

                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="WeightUnitLabel"
                                   Text="Weight (KG)"
                                   HorizontalOptions="Center"
                                   TextColor="#6B7280"/>

                            <Entry Keyboard="Numeric"
                                   Placeholder="Enter weight"
                                   TextChanged="OnWeightTextChanged"
                                   HorizontalTextAlignment="Center"
                                   FontSize="30"
                                   TextColor="#3B4CCA"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- HEIGHT -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 20"
                        Padding="20">

                    <VerticalStackLayout Spacing="10">

                        <Label x:Name="HeightUnitLabel"
                               Text="Height (CM)"
                               HorizontalOptions="Center"
                               TextColor="#6B7280"/>

                        <Label x:Name="HeightLabel"
                               Text="50"
                               FontSize="44"
                               HorizontalOptions="Center"
                               TextColor="#3B4CCA"/>

                        <Slider x:Name="HeightSlider"
                                Minimum="50"
                                Maximum="220"
                                Value="50"
                                MinimumTrackColor="#3B4CCA"
                                MaximumTrackColor="#E5E7EB"
                                ThumbColor="#3B4CCA"
                                ValueChanged="OnHeightChanged"/>

                        <Grid ColumnDefinitions="*,*">
                            <Label Text="50 cm"
                                   TextColor="#9CA3AF"/>
                            <Label Text="220 cm"
                                   HorizontalOptions="End"
                                   TextColor="#9CA3AF"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- GENDER -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 20"
                        Padding="20">

                    <VerticalStackLayout Spacing="14">

                        <Label Text="Gender"
                               HorizontalOptions="Center"
                               TextColor="#6B7280"/>

                        <Button x:Name="GenderToggleButton"
                                Text="Male"
                                Clicked="OnGenderToggle"
                                HeightRequest="50"
                                CornerRadius="25"
                                BackgroundColor="#3B4CCA"
                                TextColor="White"
                                FontAttributes="Bold"/>

                    </VerticalStackLayout>
                </Border>

                <!-- UNITS -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">

                    <Picker x:Name="WeightUnitPicker"
                            Title="Weight Unit"
                            SelectedIndexChanged="OnWeightUnitChanged"
                            TextColor="#3B4CCA">
                        <Picker.Items>
                            <x:String>kg</x:String>
                            <x:String>lb</x:String>
                        </Picker.Items>
                    </Picker>

                    <Picker Grid.Column="1"
                            x:Name="HeightUnitPicker"
                            Title="Height Unit"
                            SelectedIndexChanged="OnHeightUnitChanged"
                            TextColor="#3B4CCA">
                        <Picker.Items>
                            <x:String>cm</x:String>
                            <x:String>ft / in</x:String>
                        </Picker.Items>
                    </Picker>

                </Grid>

                <Button Text="Calculate BMI"
                        Clicked="OnCalculateClicked"
                        BackgroundColor="#3B4CCA"
                        TextColor="White"
                        CornerRadius="30"
                        HeightRequest="60"/>

            </VerticalStackLayout>

            <!-- RESULTS PAGE -->
            <VerticalStackLayout x:Name="ResultsPage"
                                 IsVisible="False"
                                 Spacing="18">

                <Label Text="Your BMI"
                       FontSize="22"
                       HorizontalOptions="Center"
                       TextColor="#6B7280"/>

                <Label x:Name="BmiWhole"
                       FontSize="72"
                       HorizontalOptions="Center"
                       TextColor="#3B4CCA"
                       FontAttributes="Bold"/>

                <Label x:Name="CategoryLabel"
                       FontSize="22"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"
                       TextColor="#111827"/>

                <Button Text="Recalculate"
                        Clicked="OnRecalculateClicked"
                        BackgroundColor="#3B4CCA"
                        TextColor="White"
                        CornerRadius="30"
                        HeightRequest="55"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>